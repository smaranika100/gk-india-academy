# ==============================================================================
# GK India Academy - Environment Variables & Backend Secrets Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the project root:
#    Copy-Item .env.example .env
# 2. Fill in your project credentials from the Supabase Dashboard.
# 3. IMPORTANT: Never commit your actual .env file or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Core (Required for Web App & Admin Dashboard)
# ------------------------------------------------------------------------------
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key: Supabase Dashboard -> Project Settings -> API -> anon (public)
# Safe for client-side authentication and public queries when RLS is enabled.
SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Backend / Service Role Key (Optional / Administrative Backups)
# ------------------------------------------------------------------------------
# Service Role Key: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
# WARNING: NEVER expose this key to browser clients. Only used by local backup/restore scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 3. Supabase Storage Buckets (File & Media Storage)
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_STUDY_MATERIALS_BUCKET=study-materials
SUPABASE_STORAGE_MEDIA_BUCKET=media-uploads

# ------------------------------------------------------------------------------
# 4. Local Development Server Port
# ------------------------------------------------------------------------------
PORT=5500
